# ============================================================
# E-FLOW Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Database (Docker Compose + Spring Boot) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eflow
POSTGRES_USER=eflow
POSTGRES_PASSWORD=changeme

# --- JWT ---
EFLOW_JWT_SECRET=changeme-generate-a-256-bit-key
EFLOW_JWT_ACCESS_EXPIRY_MS=900000
EFLOW_JWT_REFRESH_EXPIRY_MS=604800000

# --- Auth ---
EFLOW_AUTH_ALLOWED_DOMAIN=ssn.edu.in

# --- Mail (production only; dev profile prints OTP to console) ---
EFLOW_MAIL_HOST=smtp.example.com
EFLOW_MAIL_PORT=587
EFLOW_MAIL_USERNAME=changeme
EFLOW_MAIL_PASSWORD=changeme
EFLOW_MAIL_FROM=noreply@ssn.edu.in

# --- Device gateway ---
EFLOW_DEVICE_TRANSPORT=simulator
EFLOW_DEVICE_COMMAND_TIMEOUT_MS=8000
EFLOW_DEVICE_HEARTBEAT_STALE_S=60

# --- Geofencing ---
EFLOW_GEO_MAX_ACCURACY_M=50
EFLOW_GEO_MAX_STALENESS_S=30
EFLOW_GEO_MAX_SPEED_KMH=100

# --- CORS ---
EFLOW_CORS_ORIGINS=http://localhost:5173

# --- MQTT (only needed if EFLOW_DEVICE_TRANSPORT=mqtt) ---
EFLOW_MQTT_BROKER_URL=tcp://localhost:1883
EFLOW_MQTT_CLIENT_ID=eflow-backend

# --- Pricing seed defaults ---
EFLOW_PRICING_BASE_FARE=10
EFLOW_PRICING_PER_MINUTE=2
EFLOW_PRICING_GRACE_MINUTES=5
EFLOW_PRICING_MIN_CHARGE=10
EFLOW_PRICING_LATE_FEE=50
